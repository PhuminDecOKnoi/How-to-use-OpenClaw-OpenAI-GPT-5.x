# Example environment variables for local development or workshop use.
# Do not put real API keys or real tokens in this file.

OPENCLAW_ENV="development"
OPENAI_API_KEY="replace-with-your-local-key-only"
OPENCLAW_DEFAULT_PROVIDER="openai"
OPENCLAW_DEFAULT_MODEL="openai/<model-id>"
TELEGRAM_BOT_TOKEN="replace-with-demo-token-if-needed"
TELEGRAM_CHAT_ID="replace-with-demo-chat-id-if-needed"
